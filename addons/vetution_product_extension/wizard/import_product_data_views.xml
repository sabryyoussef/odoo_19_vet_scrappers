<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_product_data_form" model="ir.ui.view">
        <field name="name">vetution.import.product.data.form</field>
        <field name="model">vetution.import.product.data</field>
        <field name="arch" type="xml">
            <form string="Import Product Data">
                <sheet>
                    <group>
                        <group>
                            <field name="file_type"/>
                            <field name="file_name" readonly="1"/>
                            <field name="file_data" filename="file_name" required="1"/>
                        </group>
                        <group>
                            <field name="import_mode"/>
                            <field name="match_by"/>
                            <field name="skip_duplicates"/>
                        </group>
                    </group>
                    <group string="Import Result" col="1" invisible="not import_result">
                        <field name="import_result" readonly="1"/>
                        <field name="log_message" widget="text" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_product_data" model="ir.actions.act_window">
        <field name="name">Import Product Data</field>
        <field name="res_model">vetution.import.product.data</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_product_data"
              name="Import Product Data"
              parent="sale.sale_menu_root"
              action="action_import_product_data"
              sequence="99"/>
</odoo>

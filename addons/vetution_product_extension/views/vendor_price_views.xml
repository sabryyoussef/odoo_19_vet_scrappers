<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_price_tree" model="ir.ui.view">
        <field name="name">vetution.vendor.price.tree</field>
        <field name="model">vetution.vendor.price</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="vendor_name"/>
                <field name="price"/>
                <field name="currency"/>
                <field name="expiration_date"/>
                <field name="available" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_price_form" model="ir.ui.view">
        <field name="name">vetution.vendor.price.form</field>
        <field name="model">vetution.vendor.price</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="vendor_name"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="currency"/>
                            <field name="expiration_date"/>
                            <field name="available"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_price" model="ir.actions.act_window">
        <field name="name">Vendor Prices</field>
        <field name="res_model">vetution.vendor.price</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a vendor price
            </p>
        </field>
    </record>

    <menuitem id="menu_vendor_price"
              name="Vendor Prices"
              parent="sale.sale_menu_root"
              action="action_vendor_price"
              sequence="100"/>
</odoo>

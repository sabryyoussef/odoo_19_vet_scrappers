<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scraped Product Draft List View -->
    <record id="view_scraped_product_draft_list" model="ir.ui.view">
        <field name="name">scraped.product.draft.list</field>
        <field name="model">scraped.product.draft</field>
        <field name="arch" type="xml">
            <list string="Scraped Products" multi_edit="1">
                <field name="name"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency'}"/>
                <field name="currency" column_invisible="1"/>
                <field name="availability" decoration-success="availability == 'in_stock'"
                                          decoration-danger="availability == 'out_of_stock'"
                                          decoration-warning="availability in ('low_stock', 'pre_order')"/>
                <field name="stock_quantity" optional="hide"/>
                <field name="brand" optional="show"/>
                <field name="sku" optional="hide"/>
                <field name="scraper_config_id"/>
                <field name="last_scraped"/>
                <field name="state" decoration-success="state == 'approved'"
                                    decoration-danger="state == 'rejected'"
                                    decoration-info="state == 'imported'"
                                    widget="badge"/>
                <field name="is_duplicate" widget="boolean_toggle" optional="show"/>
                <button name="action_open_url" type="object" icon="fa-external-link" string="Open URL"/>
                <button name="action_approve" type="object" icon="fa-check" string="Approve" 
                        invisible="state != 'draft'" class="btn-success"/>
                <button name="action_reject" type="object" icon="fa-times" string="Reject" 
                        invisible="state not in ('draft', 'approved')" class="btn-danger"/>
            </list>
        </field>
    </record>

    <!-- Scraped Product Draft Form View -->
    <record id="view_scraped_product_draft_form" model="ir.ui.view">
        <field name="name">scraped.product.draft.form</field>
        <field name="model">scraped.product.draft</field>
        <field name="arch" type="xml">
            <form string="Scraped Product">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" 
                            invisible="state != 'draft'" icon="fa-check"/>
                    <button name="action_reject" string="Reject" type="object" 
                            invisible="state not in ('draft', 'approved')" icon="fa-times"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state not in ('approved', 'rejected')" icon="fa-undo"/>
                    <button name="action_import_to_unified" string="Import to Unified Scrapper" type="object" 
                            class="oe_highlight" invisible="state != 'approved'" icon="fa-upload"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,imported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_url" type="object" class="oe_stat_button" icon="fa-external-link">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View on Website</span>
                            </div>
                        </button>
                        <button name="action_view_existing_product" type="object" class="oe_stat_button" icon="fa-warning"
                                invisible="not is_duplicate">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Duplicate</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="alert alert-warning" role="alert" invisible="not is_duplicate">
                        <strong>⚠️ Potential Duplicate:</strong> A similar product already exists in Odoo.
                        <field name="existing_product_id" readonly="1"/>
                    </div>
                    
                    <div class="alert alert-success" role="alert" invisible="state != 'imported'">
                        <strong>✅ Imported:</strong> This product has been imported to Odoo.
                        <field name="imported_product_id" readonly="1"/>
                        <field name="import_date" readonly="1"/>
                    </div>
                    
                    <div class="alert alert-danger" role="alert" invisible="state != 'rejected'">
                        <strong>❌ Rejected:</strong>
                        <field name="rejection_reason" readonly="1"/>
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" string="Product Name"/>
                        <h1>
                            <field name="name" placeholder="Product Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="url" widget="url"/>
                            <field name="sku"/>
                            <field name="brand"/>
                            <field name="category"/>
                            <field name="subcategory"/>
                        </group>
                        <group string="Pricing &amp; Availability">
                            <field name="price"/>
                            <field name="currency"/>
                            <field name="regular_price"/>
                            <field name="availability"/>
                            <field name="stock_quantity"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Scraping Info">
                            <field name="scraper_config_id"/>
                            <field name="scraper_job_id"/>
                            <field name="data_source_id"/>
                            <field name="last_scraped"/>
                        </group>
                        <group string="Image">
                            <field name="image_url" widget="url"/>
                            <field name="image_url" widget="image" options="{'size': [0, 200]}" nolabel="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="text"/>
                        </page>
                        
                        <page string="Raw Data" name="raw_data">
                            <field name="raw_data" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter commented out - causing view errors
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
                -->
            </form>
        </field>
    </record>

    <!-- Scraped Product Draft Search View -->
    <record id="view_scraped_product_draft_search" model="ir.ui.view">
        <field name="name">scraped.product.draft.search</field>
        <field name="model">scraped.product.draft</field>
        <field name="arch" type="xml">
            <search string="Scraped Products">
                <field name="name"/>
                <field name="sku"/>
                <field name="brand"/>
                <field name="category"/>
                <field name="scraper_config_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="imported" string="Imported" domain="[('state', '=', 'imported')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="in_stock" string="In Stock" domain="[('availability', '=', 'in_stock')]"/>
                <filter name="out_of_stock" string="Out of Stock" domain="[('availability', '=', 'out_of_stock')]"/>
                <separator/>
                <filter name="duplicates" string="Potential Duplicates" domain="[('is_duplicate', '=', True)]"/>
                <filter name="new" string="New Products" domain="[('is_duplicate', '=', False)]"/>
                <group name="groupby">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_config" string="Scraper Config" context="{'group_by': 'scraper_config_id'}"/>
                    <filter name="group_availability" string="Availability" context="{'group_by': 'availability'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_scraped_product_draft" model="ir.actions.act_window">
        <field name="name">Scraped Products</field>
        <field name="res_model">scraped.product.draft</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scraped products yet
            </p>
            <p>
                Run a scraper configuration to start collecting product data.
            </p>
        </field>
    </record>
</odoo>

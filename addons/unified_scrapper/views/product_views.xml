    <!-- Product Template List Extension -->
    <record id="view_product_template_list_inherit_unified" model="ir.ui.view">
        <field name="name">product.template.list.inherit.unified</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="external_source" optional="hide"/>
                <field name="external_sync_status" optional="hide"
                       decoration-success="external_sync_status == 'synced'"
                       decoration-danger="external_sync_status == 'error'"
                       decoration-warning="external_sync_status == 'pending'"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search Extension -->
    <record id="view_product_template_search_inherit_unified" model="ir.ui.view">
        <field name="name">product.template.search.inherit.unified</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <!-- Add searchable fields -->
            <field name="name" position="after">
                <field name="external_source" string="External Source"/>
                <field name="external_product_id" string="External ID"/>
            </field>
            
            <!-- Add filters and group by at the end -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="External Products" name="external_products" 
                        domain="[('external_source', '!=', False), ('external_source', '!=', 'manual')]"/>
                <filter string="Manual Products" name="manual_products" 
                        domain="['|', ('external_source', '=', False), ('external_source', '=', 'manual')]"/>
                <separator/>
                <filter string="Vetution" name="vetution" domain="[('external_source', '=', 'vetution')]"/>
                <filter string="Amin Petshop" name="amin_petshop" domain="[('external_source', '=', 'amin_petshop')]"/>
                <filter string="Amazon" name="amazon" domain="[('external_source', '=', 'amazon')]"/>
                <separator/>
                <filter string="Synced" name="synced" domain="[('external_sync_status', '=', 'synced')]"/>
                <filter string="Pending Sync" name="pending_sync" domain="[('external_sync_status', '=', 'pending')]"/>
                <filter string="Sync Errors" name="sync_errors" domain="[('external_sync_status', '=', 'error')]"/>
                
                <group name="groupby">
                    <filter string="External Source" name="group_external_source" context="{'group_by': 'external_source'}"/>
                    <filter string="Sync Status" name="group_sync_status" context="{'group_by': 'external_sync_status'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Variant List Extension -->
    <record id="view_product_product_list_inherit_unified" model="ir.ui.view">
        <field name="name">product.product.list.inherit.unified</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="external_source" optional="hide"/>
                <field name="external_sync_status" optional="hide"
                       decoration-success="external_sync_status == 'synced'"
                       decoration-danger="external_sync_status == 'error'"
                       decoration-warning="external_sync_status == 'pending'"/>
            </xpath>
        </field>
    </record>

</odoo>

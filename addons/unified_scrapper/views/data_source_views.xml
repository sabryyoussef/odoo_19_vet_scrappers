<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Data Source List View -->
    <record id="view_unified_data_source_list" model="ir.ui.view">
        <field name="name">unified.data.source.list</field>
        <field name="model">unified.data.source</field>
        <field name="arch" type="xml">
            <list string="Data Sources" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_system"/>
                <field name="source_type"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_import_status" 
                       decoration-success="last_import_status == 'success'"
                       decoration-danger="last_import_status == 'failed'"
                       decoration-warning="last_import_status == 'partial'"/>
                <field name="last_import_date"/>
                <field name="products_created"/>
                <field name="products_updated"/>
                <field name="connection_status" 
                       decoration-success="connection_status == 'connected'"
                       decoration-danger="connection_status == 'error'"/>
            </list>
        </field>
    </record>

    <!-- Data Source Form View -->
    <record id="view_unified_data_source_form" model="ir.ui.view">
        <field name="name">unified.data.source.form</field>
        <field name="model">unified.data.source</field>
        <field name="arch" type="xml">
            <form string="Data Source">
                <header>
                    <button name="action_test_connection" 
                            string="Test Connection" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-plug"/>
                    <button name="action_test_login" 
                            string="Test Login" 
                            type="object" 
                            class="btn-info"
                            icon="fa-sign-in"
                            invisible="authentication_type != 'web_login'"/>
                    <button name="action_import_now" 
                            string="Import Now" 
                            type="object" 
                            class="btn-success"
                            icon="fa-download"/>
                    <field name="connection_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_field_mappings" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-exchange">
                            <field name="field_mapping_count" widget="statinfo" string="Mappings"/>
                        </button>
                        <button name="action_view_import_history" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-history">
                            <field name="import_history_count" widget="statinfo" string="Imports"/>
                        </button>
                        <button name="action_view_products" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cubes">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="products_created"/> + <field name="products_updated"/>
                                </span>
                                <span class="o_stat_text">Products</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g., Vetution Products Feed"/></h1>
                        <field name="description" placeholder="Brief description of this data source..."/>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="source_system"/>
                            <field name="source_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Connection">
                            <field name="source_url" placeholder="URL or file path"/>
                            <field name="authentication_type"/>
                            <field name="api_key" password="True" invisible="authentication_type not in ('token', 'api_key')"/>
                            <field name="api_username" invisible="authentication_type != 'basic'"/>
                            <field name="api_password" password="True" invisible="authentication_type != 'basic'"/>
                        </group>
                        <group string="Website Login" invisible="authentication_type != 'web_login'">
                            <field name="login_method"/>
                            <field name="login_url" placeholder="https://example.com/login or main page URL" invisible="login_method == 'api'"/>
                            <field name="api_login_endpoint" placeholder="/api/auth/login or full API URL" invisible="login_method != 'api'"/>
                            <field name="website_username" placeholder="username, email, or phone" invisible="login_method == 'browser'"/>
                            <field name="website_password" password="True" invisible="login_method == 'browser'"/>
                            <field name="login_status" readonly="1" invisible="login_method == 'browser'"/>
                            <field name="last_login_test" readonly="1" invisible="login_method == 'browser'"/>
                        </group>
                        <group string="Session Cookies (Manual Import)" invisible="authentication_type != 'web_login' or login_method != 'browser'" colspan="2">
                            <field name="cookie_import_help" nolabel="1" colspan="2"/>
                            <field name="login_cookies" nolabel="1" colspan="2" placeholder='{"session_id": "abc123", "auth_token": "xyz789"}' widget="text"/>
                        </group>
                        <group string="Advanced Login Settings" invisible="authentication_type != 'web_login' or login_method == 'browser'">
                            <field name="username_field_name" placeholder="e.g., phone_number (leave empty for auto-detect)"/>
                            <field name="password_field_name" placeholder="e.g., password (leave empty for auto-detect)"/>
                            <field name="login_error_message" readonly="1" colspan="2" widget="text"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Import Settings">
                            <field name="auto_import"/>
                            <field name="import_frequency" invisible="not auto_import"/>
                            <field name="match_strategy"/>
                            <field name="duplicate_handling"/>
                        </group>
                        <group string="Import Status">
                            <field name="last_import_date" readonly="1"/>
                            <field name="last_import_status" readonly="1"/>
                            <field name="products_created" readonly="1"/>
                            <field name="products_updated" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Field Mappings" name="field_mappings">
                            <field name="field_mapping_ids" context="{'default_data_source_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="external_field_name"/>
                                    <field name="target_model"/>
                                    <field name="target_field"/>
                                    <field name="transformation_rule"/>
                                    <field name="is_required"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Last Import Log" name="import_log">
                            <field name="last_import_log" readonly="1" widget="text"/>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional configuration notes and documentation..." widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Data Source Search View -->
    <record id="view_unified_data_source_search" model="ir.ui.view">
        <field name="name">unified.data.source.view.search</field>
        <field name="model">unified.data.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Source Name"/>
                <field name="source_system" string="Source System"/>
                <field name="source_type" string="Source Type"/>
                <field name="source_url" string="URL/Path"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="auto_import" string="Auto Import Enabled" domain="[('auto_import', '=', True)]"/>
                <separator/>
                <filter name="connected" string="Connected" domain="[('connection_status', '=', 'connected')]"/>
                <filter name="connection_error" string="Connection Error" domain="[('connection_status', '=', 'error')]"/>
                <separator/>
                <filter name="import_success" string="Last Import Success" domain="[('last_import_status', '=', 'success')]"/>
                <filter name="import_failed" string="Last Import Failed" domain="[('last_import_status', '=', 'failed')]"/>
                <filter name="never_imported" string="Never Imported" domain="[('last_import_status', '=', 'never')]"/>
                <group name="groupby">
                    <filter name="group_source_system" string="Source System" context="{'group_by': 'source_system'}"/>
                    <filter name="group_source_type" string="Source Type" context="{'group_by': 'source_type'}"/>
                    <filter name="group_import_status" string="Import Status" context="{'group_by': 'last_import_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Data Source Action -->
    <record id="action_unified_data_source" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">unified.data.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first data source
            </p>
            <p>
                Data sources define where your product data comes from (CSV, JSON, or API).
                Configure connection details, authentication, and import settings.
            </p>
        </field>
    </record>
</odoo>

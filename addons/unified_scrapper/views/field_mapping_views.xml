<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Field Mapping List View -->
    <record id="view_unified_field_mapping_list" model="ir.ui.view">
        <field name="name">unified.field.mapping.list</field>
        <field name="model">unified.field.mapping</field>
        <field name="arch" type="xml">
            <list string="Field Mappings" default_order="data_source_id,sequence">
                <field name="sequence" widget="handle"/>
                <field name="data_source_id"/>
                <field name="external_field_name"/>
                <field name="target_model"/>
                <field name="target_field"/>
                <field name="field_type" optional="show"/>
                <field name="transformation_rule"/>
                <field name="is_required" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Field Mapping Form View -->
    <record id="view_unified_field_mapping_form" model="ir.ui.view">
        <field name="name">unified.field.mapping.form</field>
        <field name="model">unified.field.mapping</field>
        <field name="arch" type="xml">
            <form string="Field Mapping">
                <header>
                    <button name="action_test_mapping" 
                            string="Test Mapping" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-flask"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    
                    <group>
                        <group string="Source">
                            <field name="data_source_id"/>
                            <field name="external_field_name" placeholder="e.g., product_name, price_egp"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Target">
                            <field name="target_model"/>
                            <field name="target_field" placeholder="e.g., name, list_price, default_code"/>
                            <field name="field_type" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Validation">
                            <field name="is_required"/>
                            <field name="default_value" placeholder="Default value if field is empty"/>
                        </group>
                        <group string="Transformation">
                            <field name="transformation_rule"/>
                            <field name="transformation_params" 
                                   widget="text" 
                                   placeholder='{"currency_rate": 1.5, "date_format": "%Y-%m-%d"}'
                                   invisible="transformation_rule == 'none'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Notes &amp; Examples" name="notes">
                            <field name="notes" 
                                   placeholder="Document this mapping with examples and special cases..." 
                                   widget="text"/>
                        </page>
                        
                        <page string="Transformation Help" name="help">
                            <group>
                                <group string="Available Transformations">
                                    <div>
                                        <p><strong>none:</strong> Direct mapping, no transformation</p>
                                        <p><strong>lowercase:</strong> Convert text to lowercase</p>
                                        <p><strong>uppercase:</strong> Convert text to UPPERCASE</p>
                                        <p><strong>title_case:</strong> Convert Text To Title Case</p>
                                        <p><strong>strip_html:</strong> Remove HTML tags from text</p>
                                        <p><strong>strip_whitespace:</strong> Remove extra whitespace</p>
                                    </div>
                                </group>
                                <group string="Advanced Transformations">
                                    <div>
                                        <p><strong>price_conversion:</strong> Convert currency
                                        <br/>Params: <code>{"currency_rate": 1.5}</code></p>
                                        
                                        <p><strong>date_format:</strong> Parse date with custom format
                                        <br/>Params: <code>{"date_format": "%Y-%m-%d"}</code></p>
                                        
                                        <p><strong>boolean_convert:</strong> Convert to True/False
                                        <br/>Recognizes: true, 1, yes, y, on, active, enabled</p>
                                        
                                        <p><strong>json_extract:</strong> Extract value from JSON
                                        <br/>Params: <code>{"json_path": "data.product.name"}</code></p>
                                        
                                        <p><strong>split_string:</strong> Split string to list
                                        <br/>Params: <code>{"delimiter": ","}</code></p>
                                        
                                        <p><strong>custom_python:</strong> Execute Python expression
                                        <br/>Params: <code>{"expression": "value * 1.15"}</code>
                                        <br/>Available: str, int, float, bool, len, abs, round</p>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Field Mapping Search View -->
    <record id="view_unified_field_mapping_search" model="ir.ui.view">
        <field name="name">unified.field.mapping.search</field>
        <field name="model">unified.field.mapping</field>
        <field name="arch" type="xml">
            <search string="Field Mappings">
                <field name="data_source_id" string="Data Source"/>
                <field name="external_field_name" string="External Field"/>
                <field name="target_field" string="Target Field"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="required" string="Required Fields" domain="[('is_required', '=', True)]"/>
                <separator/>
                <filter name="no_transformation" string="No Transformation" domain="[('transformation_rule', '=', 'none')]"/>
                <group name="groupby">
                    <filter name="group_data_source" string="Data Source" context="{'group_by': 'data_source_id'}"/>
                    <filter name="group_target_model" string="Target Model" context="{'group_by': 'target_model'}"/>
                    <filter name="group_field_type" string="Field Type" context="{'group_by': 'field_type'}"/>
                    <filter name="group_transformation" string="Transformation" context="{'group_by': 'transformation_rule'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Field Mapping Action -->
    <record id="action_unified_field_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">unified.field.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1, 'search_default_group_data_source': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first field mapping
            </p>
            <p>
                Field mappings define how external data fields map to Odoo product fields.
                You can apply transformations like currency conversion, date parsing, or custom Python expressions.
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amin_petshop_import_wizard_form" model="ir.ui.view">
        <field name="name">amin.petshop.import.wizard.form</field>
        <field name="model">amin.petshop.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Products from Amin Petshop">
                <sheet>
                    <group>
                        <group>
                            <field name="import_type"/>
                            <field name="filename" readonly="1"/>
                            <field name="data_file" filename="filename" required="1"/>
                        </group>
                        <group>
                            <field name="match_by"/>
                            <field name="create_new"/>
                            <field name="update_existing"/>
                        </group>
                    </group>
                    <group string="Import Results" col="1" invisible="not products_found">
                        <field name="products_found" readonly="1"/>
                        <field name="products_created" readonly="1"/>
                        <field name="products_updated" readonly="1"/>
                        <field name="errors" readonly="1"/>
                        <field name="log_message" widget="text" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amin_petshop_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Products from Amin Petshop</field>
        <field name="res_model">amin.petshop.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_amin_petshop_import"
              name="Import Products"
              parent="sale.sale_menu_root"
              action="action_amin_petshop_import_wizard"
              sequence="99"/>
</odoo>
